node_modules/
dist/
dist-ssr/
*.local
.DS_Store
.claude/

# data pipeline: raw PokeAPI cache is resumable/regenerable, don't commit
data-pipeline/cache/

# generated dataset IS committed (see src/data/generated/) so the app works
# without running the pipeline — do not ignore it.

# PMD sprite mirror: hundreds of MB of downloaded sprite art served locally by
# sprite-server/, not committed. Re-run `npm run data:fetch-pmd-sprites` (with
# PMD_SPRITE_ALL=true for the full roster) to repopulate.
pmd-sprite-mirror/

# Move SFX mirror: ~1.1GB of per-generation move sound effects, served locally
# by sprite-server/ the same way pmd-sprite-mirror/ is. Not committed — see
# src/data/generated/moveSounds.json for the small derived index that IS
# committed, and data-pipeline/build-move-sound-index.ts to regenerate it.
sound/

*.log
npm-debug.log*
*.tsbuildinfo
