node_modules/
dist/
dist-ssr/
*.local
.DS_Store
.claude/

# data pipeline: raw PokeAPI cache is resumable/regenerable, don't commit
data-pipeline/cache/

# generated dataset IS committed (see src/data/generated/) so the app works
# without running the pipeline — do not ignore it.

# PMD sprite mirror: hundreds of MB of downloaded sprite art served locally by
# sprite-server/, not committed. Re-run `npm run data:fetch-pmd-sprites` (with
# PMD_SPRITE_ALL=true for the full roster) to repopulate.
#
# All three of these are root-anchored (leading /) deliberately — an
# unanchored pattern matches a directory of that name at ANY depth, and
# "sound/" without the anchor was silently also matching (and excluding from
# git entirely) the unrelated src/render/sound/ source directory.
/pmd-sprite-mirror/

# Move SFX mirror: ~1.1GB of per-generation move sound effects. Not
# committed, and not served at runtime either — data-pipeline/
# build-move-sound-index.ts transcodes just the ~460 clips the game
# references into public/move-sounds/ (~12 MB, committed and shipped with
# the build) and writes the small index src/data/generated/moveSounds.json.
/sound/

# Background-music mirror: user-supplied per-game soundtrack packs
# (sound-track/emerald/, sound-track/red-blue/, ...), several hundred MB of
# copyrighted OST mp3s. Served locally by sprite-server/'s /soundtracks
# routes, which list the directory live — no generated index to keep in
# sync, so there's nothing here to commit even a small derived copy of.
/sound-track/

# What actually gets uploaded to the production volume, built from the raw
# mirrors above by the data-pipeline scripts (build-soundtrack.ts →
# deploy-assets/sound-track/, re-encoded and loudness-normalized;
# optimize-pmd-sprites.ts → deploy-assets/pmd-sprite-mirror/, palette PNGs
# without the unused Shadow sheets) — same "not committed" reasoning, just
# a second local tree staged for upload.
/deploy-assets/
# Older hand-made equivalents of the same thing (cover-art-stripped copies of
# /sound/ and /sound-track/); superseded by deploy-assets/, kept ignored so a
# leftover checkout can't accidentally commit them.
/sound-optimized/
/sound-track-optimized/

# The tarball of those mirrors that gets uploaded to the Fly volume by hand
# (entrypoint.sh symlinks /data/<mirror> into the container — nothing in the
# image or the repo needs it). Over 1 GB: GitHub refuses any single file
# past 100 MB, so this can never be committed, and it once was — see the
# history rewrite noted in the commit that added this rule.
/assets.tar.gz
/*.tar.gz

*.log
npm-debug.log*
*.tsbuildinfo
