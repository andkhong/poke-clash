:8080 {
	encode zstd gzip

	@api path /api/*
	handle @api {
		reverse_proxy localhost:4311 {
			flush_interval -1
		}
	}

	# The sprite server's only remaining production job is picking a random
	# track (it lists the catalog live off the volume). The files themselves
	# are served by Caddy straight from the volume below: Range requests
	# (media streaming and seeking), ETags/conditional requests and
	# sendfile for free, and one fewer hop.
	@random path /soundtracks/random
	handle @random {
		reverse_proxy localhost:4310
	}

	# PMD sprite sheets. The client tags sheet URLs with ?v=<n> (see
	# src/render/sprites/pmdSheetUrl.ts), which is what makes a year-long
	# immutable cache safe: a re-fetched or re-optimized mirror ships with a
	# new tag and never collides with what browsers already hold.
	handle_path /pmd-sprites/* {
		root * /data/pmd-sprite-mirror
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Soundtrack files: a month, not immutable — the same filename gets
	# re-encoded when the soundtrack build changes (see
	# data-pipeline/build-soundtrack.ts) and there's no version tag on
	# these, since a match picks a random one anyway.
	handle_path /soundtracks/track/* {
		root * /data/sound-track
		header Cache-Control "public, max-age=2592000"
		file_server
	}

	handle {
		root * /app/dist

		# Vite hashes bundle filenames, so those are safe to cache forever;
		# the static media under public/ changes rarely and has stable names,
		# so a month; index.html must always be revalidated or a new deploy's
		# bundle never gets picked up.
		@hashed path /assets/* /pmd-sprite-index.json
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@media path /cries/* /move-sounds/* /move-anims/* /move-assets/* /fallback-sprites/*
		header @media Cache-Control "public, max-age=2592000"
		@page path / /index.html
		header @page Cache-Control "no-cache"

		try_files {path} /index.html
		# scripts/precompress-dist.mjs writes .br/.gz siblings at build time.
		file_server {
			precompressed br gzip
		}
	}
}
