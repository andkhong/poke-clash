{
  "name": "poke-clash",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:servers": "node scripts/build-servers.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "data:build": "tsx data-pipeline/build-dataset.ts",
    "data:probe-sprites": "tsx data-pipeline/probe-sprites.ts",
    "data:fetch-fallback-sprites": "tsx data-pipeline/fetch-fallback-sprites.ts",
    "data:fetch-pmd-sprites": "tsx data-pipeline/fetch-pmd-sprites.ts",
    "data:fetch-pmd-shiny-sprites": "tsx data-pipeline/fetch-pmd-shiny-sprites.ts",
    "data:build-move-sounds": "tsx data-pipeline/build-move-sound-index.ts",
    "data:build-soundtrack": "tsx data-pipeline/build-soundtrack.ts",
    "data:optimize-pmd-sprites": "tsx data-pipeline/optimize-pmd-sprites.ts",
    "sprite:serve": "tsx sprite-server/server.ts",
    "game-server:serve": "tsx game-server/server.ts",
    "dev:all": "concurrently -n vite,sprite,game -c blue,green,magenta \"npm:dev\" \"npm:sprite:serve\" \"npm:game-server:serve\""
  },
  "dependencies": {
    "gifuct-js": "^2.1.2",
    "music-metadata": "^11.15.0",
    "phaser": "^3.90.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.5",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "@vitejs/plugin-react": "^4.3.3",
    "adm-zip": "^0.5.16",
    "concurrently": "^9.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "fast-xml-parser": "^4.5.0",
    "sharp": "^0.35.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  }
}
